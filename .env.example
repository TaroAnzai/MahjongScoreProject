# Copy to .env. All values below are examples, never production credentials.
# Keep the existing Compose project name in development to retain db_data.
# Production: set a separate, stable name such as mahjong-production.
# COMPOSE_PROJECT_NAME=mahjong-production
FLASK_ENV=development
DEBUG=false
TESTING=false
MYSQL_DATABASE=mahjongscore
MYSQL_USER=mahjong
MYSQL_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root
# URL-encode special characters in username/password; always use db in Docker.
DATABASE_URL=mysql+pymysql://mahjong:change-me-db@db:3306/mahjongscore
SECRET_KEY=change-me-generate-a-long-random-value
ADMIN_USER=admin
# Use single quotes around hashes containing $ to prevent Compose interpolation.
ADMIN_PASSWORD_HASH=''
RECAPTCHA_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=mahjong_session
FRONTEND_URL=mahjongapp-dev:/
RATELIMIT_ENABLED=false
API_TITLE=Mahjong Score API
API_VERSION=1.0.0
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/doc
OPENAPI_JSON_PATH=openapi.json
OPENAPI_REDOC_PATH=/redoc
OPENAPI_REDOC_URL=https://cdn.jsdelivr.net/npm/redoc@next/bundles/redoc.standalone.js
OPENAPI_SWAGGER_UI_PATH=/swagger-ui
OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Tokyo
# 0 retains Celery's default CPU-based concurrency. Verify VPS ExecStart first.
CELERY_WORKER_CONCURRENCY=0
CELERY_QUEUES=celery
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=30
MAIL_FROM=mahjong@example.invalid
MAIL_REPLY_TO=
MAIL_RETURN_PATH=
# Public browser configuration ONLY; never put credentials in VITE_*.
# Production API: https://api.anzai-home.com/mahjong (existing URL).
VITE_API_BASE_URL=http://localhost:6080
VITE_RECAPTCHA_SITE_KEY=
VITE_USE_HTTPS=false
VITE_SHARE_ORIGIN=mahjongapp-dev://
# Host-side Orval override (Docker production generates its own schema).
ORVAL_API_URL=http://localhost:6080/doc/openapi.json
DEV_MYSQL_PORT=3307
DEV_FRONTEND_PORT=5173
# Production: REQUIRED. Fill with actual Nginx upstream port from the VPS.
BACKEND_PORT=
FRONTEND_PORT=5180
# Existing repository defaults; match systemctl cat output before cutover.
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=30
